<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en el build de debug: configuración de red que permite texto claro hacia el emulador
     (10.0.2.2), donde corre la API local sin HTTPS, y un receptor para correr la sincronización
     en segundo plano desde la terminal. En release no existen y Android exige HTTPS. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config">

        <!-- Para probar la notificación sin esperar los 15 minutos (ver SincronizarAhoraReceiver). -->
        <receiver
            android:name=".debug.SincronizarAhoraReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ar.edu.uade.zonda.SINCRONIZAR" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
