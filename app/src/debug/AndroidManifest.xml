<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en el build de debug: un receptor para correr la sincronización en segundo plano desde la
     terminal. La configuración de red no se declara acá: el manifiesto principal ya apunta a
     res/xml/network_security_config.xml y, en debug, ese archivo es el de esta carpeta, que permite
     texto claro hacia la API local. En release no existen ni el receptor ni esa excepción. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Para probar la notificación sin esperar los 15 minutos (ver SincronizarAhoraReceiver). -->
        <receiver
            android:name=".debug.SincronizarAhoraReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="ar.edu.uade.zonda.SINCRONIZAR" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
