<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de red del build de debug (docs/decisiones.md, decisiones 12 y 26). Reemplaza a la de
    release (src/main/res/xml/network_security_config.xml) y es igual salvo una excepción:

    Se permite tráfico sin cifrar únicamente hacia la computadora donde corre la API:
    - 10.0.2.2, la dirección con la que el emulador de Android la ve.
    - 127.0.0.1 y localhost, para un teléfono conectado por USB con `adb reverse tcp:8000 tcp:8000`
      (así se prueba Telegram en un teléfono real sin pasar por Caddy).
    Cualquier otro destino exige HTTPS con un certificado de una autoridad del sistema.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
