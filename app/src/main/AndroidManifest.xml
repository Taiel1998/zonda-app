<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para saber si hay conexión antes de enviar o encolar una acción (informe, sección 14.1). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Escanear el QR de pareo. Sin cámara (o sin permiso) los datos se ingresan a mano (RNF06). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Notificación local cuando llega una alerta alta (Android 13 o superior lo pide). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- La hoja de compartir del Resumen ofrece solo estas apps si están instaladas (Figma 107-5511);
         desde Android 11 hay que declararlas para poder ver si están. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.apps.docs" />
    </queries>

    <!-- allowBackup en false: la base local y el token no van a ninguna copia de seguridad (RNF03).
         dataExtractionRules: lo mismo desde Android 12, donde allowBackup apaga la copia en la nube pero no el
         pase de datos a un teléfono nuevo (res/xml/reglas_de_extraccion.xml).
         networkSecurityConfig: solo HTTPS, también en Android 8 (RNF04; res/xml/network_security_config.xml). -->
    <application
        android:name=".ZondaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_de_extraccion"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zonda">

        <!-- WorkManager lo inicializa ZondaApp con su propia fábrica de workers (sin Hilt), así que se
             desactiva el inicializador automático. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- La imagen del Resumen que se comparte: solo la carpeta "compartir" de la caché, y cada app
             recibe permiso de lectura para esa imagen nada más (res/xml/archivos_compartidos.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archivos_compartidos" />
        </provider>

        <!-- El enlace del aviso de Telegram no llega acá directo: entra por PuenteDelAvisoActivity, que
             se lo pasa a esta con una tarea limpia. La notificación propia sí abre esta Activity directo. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zonda">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla puente de los enlaces del aviso (cambio 23, decisión 31): sin ventana, se cierra
             apenas le pasa el enlace a MainActivity. Sin afinidad de tarea, fuera de recientes y sin
             historial, Android la crea de cero en cada toque, aunque sea el mismo aviso que abrió Zonda. -->
        <activity
            android:name=".PuenteDelAvisoActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">

            <!-- Enlace del aviso de Telegram (App Link): https://taiel1998.github.io/a/{id}.
                 Android lo verifica contra /.well-known/assetlinks.json de ese dominio. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="taiel1998.github.io"
                    android:pathPrefix="/a/"
                    android:scheme="https" />
            </intent-filter>
        </activity>
    </application>

</manifest>
