<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para saber si hay conexión antes de enviar o encolar una acción (informe, sección 14.1). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Escanear el QR de pareo. Sin cámara (o sin permiso) los datos se ingresan a mano (RNF06). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Notificación local cuando llega una alerta alta (Android 13 o superior lo pide). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup en false: la base local y el token no van a ninguna copia de seguridad (RNF03). -->
    <application
        android:name=".ZondaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zonda">

        <!-- WorkManager lo inicializa ZondaApp con su propia fábrica de workers (sin Hilt), así que se
             desactiva el inicializador automático. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Zonda">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Enlace del aviso de Telegram (App Link): https://taiel1998.github.io/a/{id}.
                 Android lo verifica contra /.well-known/assetlinks.json de ese dominio. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="taiel1998.github.io"
                    android:pathPrefix="/a/"
                    android:scheme="https" />
            </intent-filter>
        </activity>
    </application>

</manifest>
