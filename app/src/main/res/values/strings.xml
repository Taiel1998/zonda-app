    <string name="escanear_titulo">Escanear código</string>
    <string name="escanear_apunta">Apuntá la cámara al código QR que generó el administrador</string>
    <string name="escanear_no_es_zonda">Ese QR no es de Zonda. Pedile al administrador el código de pareo.</string>
    <string name="escanear_sin_permiso_titulo">Zonda no tiene permiso para usar la cámara</string>
    <string name="escanear_sin_permiso_texto">Sin cámara no se puede escanear el QR, pero podés ingresar el código a mano: son la dirección del servidor y 8 caracteres.</string>
    <string name="escanear_sin_permiso_ajustes">Si preferís escanear, permití el acceso a la cámara desde los ajustes del sistema y volvé a esta pantalla.</string>
    <string name="escanear_sin_camara_titulo">Este teléfono no tiene cámara</string>
    <string name="escanear_sin_camara_texto">Ingresá a mano la dirección del servidor y el código de 8 caracteres que te dio el administrador.</string>
    <string name="escanear_a_mano">Ingresar código a mano</string>
    <string name="escanear_a_mano_abajo">Ingresar el código a mano</string>
    <string name="escanear_aviso_codigo">El código sirve una sola vez y vence a los 10 minutos. La conexión se verifica antes de enviar nada.</string>
    <string name="error_pareo_vencido_titulo">El código venció o ya se usó</string>
    <string name="error_pareo_vencido_texto">Cada código sirve una sola vez y vence a los 10 minutos. Pedile al administrador un código nuevo y volvé a escanearlo.</string>
    <string name="error_pareo_invalido_titulo">El código no es válido</string>
    <string name="error_pareo_invalido_texto">Revisá que esté bien copiado: son 8 caracteres, por ejemplo K7M2-QX9P.</string>
    <string name="error_pareo_sin_servidor_titulo">No se pudo conectar</string>
    <string name="error_pareo_sin_servidor_texto">Revisá que estés en la red de la empresa (o conectado a su VPN), que la computadora del servidor esté encendida y que la dirección esté bien escrita.</string>
    <string name="error_pareo_codigo_valido_hasta">El código sigue siendo válido hasta las %1$s.</string>
    <string name="error_pareo_no_verificado_titulo">No se pudo verificar el servidor</string>
    <string name="error_pareo_no_verificado_texto">La dirección respondió, pero su certificado no es válido para ese nombre. La app no envió el código ni ningún otro dato.</string>
    <string name="error_pareo_no_verificado_vpn">Avisale al administrador. Si estás fuera de la empresa, conectate a la VPN y reintentá.</string>
    <string name="error_pareo_otro_titulo">El servidor no respondió bien</string>
    <string name="error_pareo_otro_texto">Probá de nuevo en unos minutos.</string>
