    <!-- Primer inicio (RF05) -->
    <string name="bienvenida_titulo">Bienvenido a Zonda</string>
    <string name="bienvenida_texto">Zonda te avisa en el teléfono cuando el sistema detecta tráfico interno anómalo en la red de tu empresa, y te deja revisar cada alerta desde donde estés.</string>
    <string name="bienvenida_avisos_titulo">Avisos en el momento</string>
    <string name="bienvenida_avisos_texto">Por Telegram y como notificación, según la severidad que elijas</string>
