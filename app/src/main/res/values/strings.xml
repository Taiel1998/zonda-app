    <!-- Ayudas (Figma 66-4286 y 66-4353) -->
    <string name="ayuda_red_titulo">Estar en la red de la empresa</string>
    <string name="ayuda_red_intro">Zonda se conecta al servidor que está dentro de tu empresa. Por eso, para parear, el teléfono tiene que estar en esa red.</string>
    <string name="ayuda_red_paso_1">Conectate al wifi de la oficina, no a los datos del celular.</string>
    <string name="ayuda_red_paso_2">Si estás afuera y la empresa tiene VPN, activala primero.</string>
    <string name="ayuda_red_paso_3">Si no sabés cuál es el wifi, preguntale al administrador.</string>
    <string name="ayuda_codigo_intro">El código se genera en la computadora donde está instalado Zonda.</string>
    <string name="ayuda_codigo_paso_1">El administrador abre la terminal en esa computadora y escribe zonda pair.</string>
    <string name="ayuda_codigo_paso_2">Aparece un código QR y, debajo, el mismo código en texto (por ejemplo K7M2-QX9P).</string>
    <string name="ayuda_codigo_paso_3">Escaneá el QR o escribí el código acá. Sirve una sola vez y vence a los 10 minutos.</string>
