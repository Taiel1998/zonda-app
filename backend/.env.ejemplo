# Copiar este archivo como .env (que no se commitea) y completar los valores.

# --- API (todas opcionales; los valores de abajo son los que usa si no están) ---
# Identidad de la red que sirve este servidor (una API por red)
ZONDA_RED_ID=red-oficina
ZONDA_RED_NOMBRE=Oficina central
# Dirección que va en el QR de pareo. Sin esta línea es https://<ZONDA_DOMINIO> si hay nombre, y si no,
# la API local (http://127.0.0.1:8000). Hace falta solo para otra dirección.
# ZONDA_URL_PUBLICA=https://zonda.empresa.com.ar
# Archivo SQLite y JSON con las alertas de muestra
ZONDA_DB_PATH=zonda.db
ZONDA_SEMILLA=alertas_semilla.json
# Segundos entre alertas nuevas durante la demo (0 apaga el emisor)
ZONDA_EMITIR_CADA=0
# Copias de la semilla, solo para probar la lista con 1.000 alertas
ZONDA_MULTIPLICAR=1
# 1 deja revisadas tres de cada cuatro alertas de la semilla, para la demo y las capturas del Resumen
# (se aplica al cargar la semilla en una base nueva: borrar zonda.db antes de arrancar)
ZONDA_REVISAR_SEMILLA=0

# --- Publicación con HTTPS (Caddy + DuckDNS + Let's Encrypt; lo levanta demo.cmd) ---
# Nombre completo de la API en DuckDNS, por ejemplo zonda-equipo.duckdns.org
ZONDA_DOMINIO=
# Token de la cuenta de DuckDNS (está arriba de todo en duckdns.org al iniciar sesión). Es una
# contraseña: no va al repositorio ni a un chat.
DUCKDNS_TOKEN=

# --- Bot de Telegram ---
# Token del bot (lo da BotFather). Sin token la API anda igual, pero sin bot ni avisos por Telegram.
TELEGRAM_BOT_TOKEN=
# Usuario del bot, por si Telegram no responde al arrancar (si responde, vale el que dice Telegram)
ZONDA_TELEGRAM_BOT=zonda_alertas_bot
# Dirección del enlace de cada aviso: el App Link que abre la alerta en la app (decisión 9)
ZONDA_ENLACE_AVISO=https://taiel1998.github.io/a/

# --- Ingesta de alertas desde la plataforma de detección (prueba de punta a punta) ---
# Token con el que el pipeline en vivo del laboratorio manda episodios a POST /ingesta/alertas
# (cabecera X-Token-Ingesta). Sin token, la ruta responde 503. Es una contraseña: no va al repositorio
# ni a un chat. Generar uno largo, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ZONDA_INGESTA_TOKEN=

# --- Latido del análisis en vivo (tarjeta Estado del sistema y aviso de Telegram) ---
# El pipeline en vivo manda POST /ingesta/latido en cada ciclo con el mismo token. Segundos sin latido
# para dar el análisis por detenido, y cada cuántos segundos lo revisa el vigía.
ZONDA_LATIDO_LIMITE=120
ZONDA_LATIDO_REVISAR_CADA=15
# Porcentaje de pérdida de captura de Zeek (capture_loss.log, que mide cada 15 minutos) desde el que el
# sensor ve parcialmente: la tarjeta lo pone en amarillo y Telegram avisa al empezar y al normalizarse.
ZONDA_PERDIDA_LIMITE=1.0

# --- Bloqueos en el firewall (decisión 51) ---
# Token con el que el agente del firewall lee los bloqueos aprobados (GET /firewall/bloqueos, cabecera
# X-Token-Firewall). Sin token, los bloqueos están apagados y la red queda en modo de observación. Es una
# contraseña: no va al repositorio ni a un chat. Uno distinto del de la ingesta.
ZONDA_FIREWALL_TOKEN=
# Segundos sin que el firewall pregunte para darlo por desconectado, y los topes: bloqueos activos a la vez
# y pedidos por dispositivo en una hora.
ZONDA_FIREWALL_LIMITE=60
ZONDA_MAX_BLOQUEOS=20
ZONDA_BLOQUEOS_POR_HORA=10
